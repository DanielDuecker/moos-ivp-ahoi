//--------    MIT pattern   -------------

initialize   DEPLOY = false
initialize   LOITER_REGION = west
initialize    ACQUIRE_FIX = false

//----------------------------------------------
Behavior=BHV_ConstantDepth
{
  name       = const_depth
  pwt        = 100
  #ifdef XMODE SEASCOUT
      condition = IN_WATER=true
      condition = NVGR_ROLLING_POWER < 80
  #elseifdef XMODE SIM
      condition  = DEPLOY = true
  #endif
  condition    = ACQUIRE_FIX = false
  perpetual  = true

     duration = no-time-limit
        depth = 1

    basewidth = 20
    peakwidth = 3
  summitdelta = 50
}
//----------------------------------------------
Behavior = BHV_Waypoint
{ 
  name      = waypt_survey
  pwt       = 100
  
  #ifdef XMODE SEASCOUT
      condition = IN_WATER=true
      condition = NVGR_ROLLING_POWER < 80
  #elseifdef XMODE SIM
      condition  = DEPLOY = true
  #endif
  condition    = ACQUIRE_FIX = false

  endflag   = ACQUIRE_FIX = true

  updates    = WPT_UPDATE
  perpetual  = false

	         speed_alt = 1.2
       use_alt_speed = true
                lead = 8
         lead_damper = 1
       lead_to_start = true
               #ifdef XMODE SEASCOUT
                  speed = 30
              #elseifdef XMODE SIM
                  speed = 2.5
              #endif
        capture_line = true
      capture_radius = 5.0
         slip_radius = 15.0
	efficiency_measure = all
		points = pts={-13.5,-208.8:-51.3,-133.5:-47.4,-122.9:-38.5,-117.7:-31.8,-118.9:-25.7,-122.4:-21.9,-126.4:-15.7,-134:-10.8,-141.6:-6.9,-149.2:-1.9,-155.7:1.5,-160.9:5.9,-166.8:10.3,-172.6:14.2,-179:19.2,-184.9:20.9,-189.6:12.6,-190.7:8.7,-172.6:-19.6,-128.2:-18.5,-115.3:-14.1,-107.8:-8.5,-105.4:-1.9,-103.1:5.9,-104.8:12,-113.6:43.1,-168.5:57,-170.3:63.1,-165:63.1,-153.9:60.3,-139.9:55.9,-124.7:52.5,-111.3:47.5,-99:44.2,-87.9:38.1,-83.8:31.4,-88.5:32,-94.9:39.2,-101.3:47,-108.3:67,-127.6:75.8,-138.1:84.7,-144.6:95.8,-150.4:104.7,-147.5:114.1,-141.6:123.6,-136.4:127.5,-131.7:125.2,-115.3:121.4,-99.6:116.9,-89.1:110.3,-73.9:104.7,-64.5:99.7,-58.1:95.3,-52.8:85.3,-55.7:76.9,-62.8:70.3,-70.4:67.5,-74.4:68.1,-79.7:74.7,-80.3:79.2,-76.2:83.6,-65.1:91.9,-56.9:104.1,-49.3:118,-43.5:128,-39.4}
               order = normal
             repeat  = 0

    visual_hints = nextpt_color=yellow
    visual_hints = nextpt_vertex_size=8
    visual_hints = nextpt_lcolor=gray70
    visual_hints = vertex_color=dodger_blue, edge_color=white
    visual_hints = vertex_size=5, edge_size=1
}

//**********************************************
// @(SURFACING) DURATION=6, H=210, S=30, D=0
//----------------------------------------------
 
 Behavior = BHV_ConstantDepth
 {
   // General Behavior Parameters
   // ---------------------------
   name         = surfacing_dpth   // example
   pwt          = 100                // default

   #ifdef XMODE SEASCOUT
      condition = IN_WATER=true
      condition = NVGR_ROLLING_POWER < 80
  #elseifdef XMODE SIM
      condition  = DEPLOY = true
  #endif
  condition    = ACQUIRE_FIX = true

   updates      = CONST_DEP_UPDATES  // example

   // Parameters specific to this behavior
   // ------------------------------------
            basewidth = 100          // default
                depth = 0            // default
   depth_mismatch_var = DEPTH_DIFF   // example
             duration = 6            // default
            peakwidth = 3            // default
          summitdelta = 50           // default
 }

 Behavior = BHV_ConstantSpeed
 {
   // General Behavior Parameters
   // ---------------------------
   name         = surfacing_spd  // example
   pwt          = 100                // default
   #ifdef XMODE SEASCOUT
      condition = IN_WATER=true
      condition = NVGR_ROLLING_POWER < 80
  #elseifdef XMODE SIM
      condition  = DEPLOY = true
  #endif
  condition    = ACQUIRE_FIX = true

   updates      = CONST_SPD_UPDATES  // example

   // Parameters specific to this behavior
   // ------------------------------------
            basewidth = 0.2          // default
             duration = 6            // default
#ifdef XMODE SEASCOUT
      speed = 30
  #elseifdef XMODE SIM
      speed = 2.5
  #endif
   speed_mismatch_var = SPEED_DIFF   // example
            peakwidth = 0            // default
          summitdelta = 0            // default
 }

Behavior = BHV_ConstantHeading
 {
   // General Behavior Parameters
   // ---------------------------
   name         = surfacing_hdg            // example
   pwt          = 100                  // default
   #ifdef XMODE SEASCOUT
      condition = IN_WATER=true
      condition = NVGR_ROLLING_POWER < 80
  #elseifdef XMODE SIM
      condition  = DEPLOY = true
  #endif
  condition    = ACQUIRE_FIX = true

   updates      = CONST_HDG_UPDATES    // example

   // Parameters specific to this behavior
   // ------------------------------------
              basewidth = 10           // default
               duration = 6            // default
                  heading = 210            // default
   heading_mismatch_var = HDG_DIFF     // example
              peakwidth = 10           // default
            summitdelta = 25           // default
 }
//**********************************************
// @(ACQUIRING FIX) DURATION=60, H=210, S=0, D=0
//----------------------------------------------
 
 Behavior = BHV_ConstantDepth
 {
   // General Behavior Parameters
   // ---------------------------
   name         = fixing_depth   // example
   pwt          = 100                // default
   #ifdef XMODE SEASCOUT
      condition = IN_WATER=true
      condition = NVGR_ROLLING_POWER < 80
  #elseifdef XMODE SIM
      condition  = DEPLOY = true
  #endif
  condition    = ACQUIRE_FIX = true

   updates      = CONST_DEP_UPDATES  // example


   // Parameters specific to this behavior
   // ------------------------------------
            basewidth = 100          // default
                depth = 0            // default
   depth_mismatch_var = DEPTH_DIFF   // example
             duration = 60            // default
            peakwidth = 3            // default
          summitdelta = 50           // default
 }

 Behavior = BHV_ConstantSpeed
 {
   // General Behavior Parameters
   // ---------------------------
   name         = fixing_speed  // example
   pwt          = 100                // default
   #ifdef XMODE SEASCOUT
      condition = IN_WATER=true
      condition = NVGR_ROLLING_POWER < 80
  #elseifdef XMODE SIM
      condition  = DEPLOY = true
  #endif
  condition    = ACQUIRE_FIX = true

   updates      = CONST_SPD_UPDATES  // example
   endflag = MISSION_COMPLETE=true


   // Parameters specific to this behavior
   // ------------------------------------
            basewidth = 0.2          // default
             duration = 60            // default
                speed = 0            // default
   speed_mismatch_var = SPEED_DIFF   // example
            peakwidth = 0            // default
          summitdelta = 0            // default
 }

Behavior = BHV_ConstantHeading
 {
   // General Behavior Parameters
   // ---------------------------
   name         = fixing_heading            // example
   pwt          = 100                  // default
   #ifdef XMODE SEASCOUT
      condition = IN_WATER=true
      condition = NVGR_ROLLING_POWER < 80
  #elseifdef XMODE SIM
      condition  = DEPLOY = true
  #endif
  condition    = ACQUIRE_FIX = true

   updates      = CONST_HDG_UPDATES    // example
   endflag = MISSION_COMPLETE=true
   endflag = VIEW_RANGE_PULSE = x=0,y=0,radius=50,duration=10,fill=0.9,label=archie_ping, edge_color=white,fill_color=white,time=2700438154.35,edge_size=1


   // Parameters specific to this behavior
   // ------------------------------------
              basewidth = 10           // default
               duration = 60            // default
                  heading = 210            // default
   heading_mismatch_var = HDG_DIFF     // example
              peakwidth = 10           // default
            summitdelta = 25           // default
 }

 Behavior = BHV_MaxDepth
 {
   // General Behavior Parameters
   // ---------------------------
   name      = maxdepth
   pwt       = 1000
   condition = IN_WATER = true 
condition = NVGR_ROLLING_POWER < 80
condition = IN_WATER = true


   // Parameters specific to this behavior
   // ------------------------------------
         max_depth = 2 // (meters)
         tolerance = 0.5                // default (meters)
   depth_slack_var = DEPTH_SLACK      // example
 }