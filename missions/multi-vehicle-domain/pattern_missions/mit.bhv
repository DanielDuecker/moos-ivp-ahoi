//--------    MIT pattern   -------------

initialize   DEPLOY = false
initialize   LOITER_REGION = west
initialize    ACQUIRE_FIX = false

//----------------------------------------------
Behavior=BHV_ConstantDepth
{
  name       = const_depth
  pwt        = 100
  #ifdef XMODE SEASCOUT
      condition = IN_WATER=true
      condition = NVGR_ROLLING_POWER < 80
  #elseifdef XMODE SIM
      condition  = DEPLOY = true
  #endif
  condition    = ACQUIRE_FIX = false
  perpetual  = true

     duration = no-time-limit
        depth = 1

    basewidth = 20
    peakwidth = 3
  summitdelta = 50
}
//----------------------------------------------
Behavior = BHV_Waypoint
{ 
  name      = waypt_survey
  pwt       = 100
  
  #ifdef XMODE SEASCOUT
      condition = IN_WATER=true
      condition = NVGR_ROLLING_POWER < 80
  #elseifdef XMODE SIM
      condition  = DEPLOY = true
  #endif
  condition    = ACQUIRE_FIX = false

  endflag   = ACQUIRE_FIX = true

  updates    = WPT_UPDATE
  perpetual  = false

	         speed_alt = 1.2
       use_alt_speed = true
                lead = 8
         lead_damper = 1
       lead_to_start = true
               #ifdef XMODE SEASCOUT
                  speed = 30
              #elseifdef XMODE SIM
                  speed = 2.5
              #endif
        capture_line = true
      capture_radius = 5.0
         slip_radius = 15.0
	efficiency_measure = all
		points = pts={-7.6,-162.1:-19.4,-129.2:-27.2,-111.8:-35.9,-94.3:-32,-84.1:-24.3,-79.9:-15.4,-79.9:-7.6,-86:-2.8,-95.3:1.1,-103.5:4.1,-110.7:8.9,-118.9:12,-125.2:15.9,-130.3:19.7,-133.3:23.6,-136.4:26.5,-139.5:22.7,-143.6:17.8,-143.6:17.8,-140.6:17.8,-137.5:15.9,-132.4:10.9,-124:5,-113.8:-6.6,-88.1:-6.6,-79.9:-3.7,-70.6:3.1,-66.6:10.9,-66.6:16.8,-72.7:19.7,-79.9:23.6,-89.2:27.5,-95.3:30.4,-102.5:33.4,-110.7:37.2,-120:41.3,-126.1:45.2,-133.3:52,-133.3:54.9,-129.2:58.8,-125.2:59.7,-117:58.8,-110.7:54.9,-99.5:51,-91.1:48.1,-85:44.2,-77.8:41.3,-70.6:37.2,-64.5:35.3,-60.3:32.4,-61.4:28.5,-58.4:29.5,-52.1:32.4,-51.1:38.2,-50:38.2,-55.2:37.2,-61.4:41.3,-69.6:50,-87.1:59.7,-110.7:64.6,-114.9:73.5,-117.9:83.2,-114.9:91,-109.7:96.8,-108.6:99.9,-106.7:104.7,-103.5:110.6,-100.4:109.6,-91.1:103.8,-79.9:93.9,-62.4:86.1,-42.8:79.3,-31.6:72.5,-33.6:63.6,-35.7:55.8,-40.9:51,-42.8:50,-47.9:54.9,-51.1:59.7,-47:61.7,-39.8:68.5,-34.6:100.8,-18.2}
               order = normal
             repeat  = 0

    visual_hints = nextpt_color=yellow
    visual_hints = nextpt_vertex_size=8
    visual_hints = nextpt_lcolor=gray70
    visual_hints = vertex_color=dodger_blue, edge_color=white
    visual_hints = vertex_size=5, edge_size=1
}

//**********************************************
// @(SURFACING) DURATION=6, H=210, S=30, D=0
//----------------------------------------------
 
 Behavior = BHV_ConstantDepth
 {
   // General Behavior Parameters
   // ---------------------------
   name         = surfacing_dpth   // example
   pwt          = 100                // default

   #ifdef XMODE SEASCOUT
      condition = IN_WATER=true
      condition = NVGR_ROLLING_POWER < 80
  #elseifdef XMODE SIM
      condition  = DEPLOY = true
  #endif
  condition    = ACQUIRE_FIX = true

   updates      = CONST_DEP_UPDATES  // example

   // Parameters specific to this behavior
   // ------------------------------------
            basewidth = 100          // default
                depth = 0            // default
   depth_mismatch_var = DEPTH_DIFF   // example
             duration = 6            // default
            peakwidth = 3            // default
          summitdelta = 50           // default
 }

 Behavior = BHV_ConstantSpeed
 {
   // General Behavior Parameters
   // ---------------------------
   name         = surfacing_spd  // example
   pwt          = 100                // default
   #ifdef XMODE SEASCOUT
      condition = IN_WATER=true
      condition = NVGR_ROLLING_POWER < 80
  #elseifdef XMODE SIM
      condition  = DEPLOY = true
  #endif
  condition    = ACQUIRE_FIX = true

   updates      = CONST_SPD_UPDATES  // example

   // Parameters specific to this behavior
   // ------------------------------------
            basewidth = 0.2          // default
             duration = 6            // default
#ifdef XMODE SEASCOUT
      speed = 30
  #elseifdef XMODE SIM
      speed = 2.5
  #endif
   speed_mismatch_var = SPEED_DIFF   // example
            peakwidth = 0            // default
          summitdelta = 0            // default
 }

Behavior = BHV_ConstantHeading
 {
   // General Behavior Parameters
   // ---------------------------
   name         = surfacing_hdg            // example
   pwt          = 100                  // default
   #ifdef XMODE SEASCOUT
      condition = IN_WATER=true
      condition = NVGR_ROLLING_POWER < 80
  #elseifdef XMODE SIM
      condition  = DEPLOY = true
  #endif
  condition    = ACQUIRE_FIX = true

   updates      = CONST_HDG_UPDATES    // example

   // Parameters specific to this behavior
   // ------------------------------------
              basewidth = 10           // default
               duration = 6            // default
                  heading = 210            // default
   heading_mismatch_var = HDG_DIFF     // example
              peakwidth = 10           // default
            summitdelta = 25           // default
 }
//**********************************************
// @(ACQUIRING FIX) DURATION=60, H=210, S=0, D=0
//----------------------------------------------
 
 Behavior = BHV_ConstantDepth
 {
   // General Behavior Parameters
   // ---------------------------
   name         = fixing_depth   // example
   pwt          = 100                // default
   #ifdef XMODE SEASCOUT
      condition = IN_WATER=true
      condition = NVGR_ROLLING_POWER < 80
  #elseifdef XMODE SIM
      condition  = DEPLOY = true
  #endif
  condition    = ACQUIRE_FIX = true

   updates      = CONST_DEP_UPDATES  // example


   // Parameters specific to this behavior
   // ------------------------------------
            basewidth = 100          // default
                depth = 0            // default
   depth_mismatch_var = DEPTH_DIFF   // example
             duration = 60            // default
            peakwidth = 3            // default
          summitdelta = 50           // default
 }

 Behavior = BHV_ConstantSpeed
 {
   // General Behavior Parameters
   // ---------------------------
   name         = fixing_speed  // example
   pwt          = 100                // default
   #ifdef XMODE SEASCOUT
      condition = IN_WATER=true
      condition = NVGR_ROLLING_POWER < 80
  #elseifdef XMODE SIM
      condition  = DEPLOY = true
  #endif
  condition    = ACQUIRE_FIX = true

   updates      = CONST_SPD_UPDATES  // example
   endflag = MISSION_COMPLETE=true


   // Parameters specific to this behavior
   // ------------------------------------
            basewidth = 0.2          // default
             duration = 60            // default
                speed = 0            // default
   speed_mismatch_var = SPEED_DIFF   // example
            peakwidth = 0            // default
          summitdelta = 0            // default
 }

Behavior = BHV_ConstantHeading
 {
   // General Behavior Parameters
   // ---------------------------
   name         = fixing_heading            // example
   pwt          = 100                  // default
   #ifdef XMODE SEASCOUT
      condition = IN_WATER=true
      condition = NVGR_ROLLING_POWER < 80
  #elseifdef XMODE SIM
      condition  = DEPLOY = true
  #endif
  condition    = ACQUIRE_FIX = true

   updates      = CONST_HDG_UPDATES    // example
   endflag = MISSION_COMPLETE=true
   endflag = VIEW_RANGE_PULSE = x=0,y=0,radius=50,duration=10,fill=0.9,label=archie_ping, edge_color=white,fill_color=white,time=2700438154.35,edge_size=1


   // Parameters specific to this behavior
   // ------------------------------------
              basewidth = 10           // default
               duration = 60            // default
                  heading = 210            // default
   heading_mismatch_var = HDG_DIFF     // example
              peakwidth = 10           // default
            summitdelta = 25           // default
 }

 Behavior = BHV_MaxDepth
 {
   // General Behavior Parameters
   // ---------------------------
   name      = maxdepth
   pwt       = 1000
   condition = IN_WATER = true 
condition = NVGR_ROLLING_POWER < 80
condition = IN_WATER = true


   // Parameters specific to this behavior
   // ------------------------------------
         max_depth = 2 // (meters)
         tolerance = 0.5                // default (meters)
   depth_slack_var = DEPTH_SLACK      // example
 }