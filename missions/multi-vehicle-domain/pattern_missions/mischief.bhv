//--------    Mischief pattern   -------------

initialize   DEPLOY = false
initialize    MD = drawing

//----------------------------------------------
Behavior=BHV_ConstantDepth
{
  name       = const_depth
  pwt        = 100
  #ifdef XMODE SEASCOUT
      condition = IN_WATER=true
      condition = NVGR_ROLLING_POWER < 80
  #elseifdef XMODE SIM
      condition  = DEPLOY = true
  #endif
  perpetual  = true

     duration = no-time-limit
        depth = 0.75

    basewidth = 20
    peakwidth = 3
  summitdelta = 50
}

//----------------------------------------------
Behavior = BHV_Waypoint
{ 
  name      = waypt_survey
  pwt       = 100
  
  #ifdef XMODE SEASCOUT
      condition = IN_WATER=true
      condition = NVGR_ROLLING_POWER < 80
  #elseifdef XMODE SIM
      condition  = DEPLOY = true
  #endif
  condition = MD = drawing

  endflag = MD = surfacing

  updates    = WPT_UPDATE
  perpetual  = false

	         speed_alt = 1.2
       use_alt_speed = true
                lead = 8
         lead_damper = 1
       lead_to_start = true
               #ifdef XMODE SEASCOUT
                  speed = 30
              #elseifdef XMODE SIM
                  speed = 2.5
              #endif
        capture_line = true
      capture_radius = 5.0
         slip_radius = 15.0
	efficiency_measure = all
		points = pts={10,-70:15.5,-82.3:19.7,-91.1:23.2,-100:32.4,-111.1:46.4,-111.1:57,-109.6:64.7,-103.7:73.2,-97.1:77.4,-90.4:77.4,-71.9:76,-62.3:66.1,-57.8:54.9,-58.6:45.7,-63:36.6,-69.7:31.7,-77.8:30.3,-85.2:28.8,-92.6:27.4,-102.2:25.3,-111.1:23.9,-119.3:20.4,-126.7:8.4,-132.6:-4.2,-138.5:-19.7,-140:-28.8,-131.9:-33,-118.5:-32.3,-105.2:-26.7,-100.8:-20.4,-95.6:-11.9,-93.4:-2.1,-97.1:3.5,-103.7:8.4,-108.2:12.7,-114.8:16.9,-123:20.4,-131.9:26,-140.7:33.8,-154.1:38.7,-164.4:44.3,-179.2:49.2,-188.1:53.5,-196.3:64.7,-200:73.9,-198.5:82.3,-193.3:83.7,-182.2:77.4,-174.1:73.2,-163.7:66.8,-154.8:59.8,-143:53.5,-133.3:47.8,-123:45.7,-118.5:41.5,-111.1:36.6,-101.5:32.4,-94.1:26,-83:21.8,-74.8:18.3,-66.7}
               order = normal
             repeat  = 0

    visual_hints = nextpt_color=yellow
    visual_hints = nextpt_vertex_size=8
    visual_hints = nextpt_lcolor=gray70
    visual_hints = vertex_color=dodger_blue, edge_color=white
    visual_hints = vertex_size=5, edge_size=1
}

//**********************************************
// @(SURFACING) DURATION=6, H=210, S=30, D=0
//----------------------------------------------
 
 Behavior = BHV_ConstantDepth
 {
   // General Behavior Parameters
   // ---------------------------
   name         = surfacing_dpth   // example
   pwt          = 100                // default

   #ifdef XMODE SEASCOUT
      condition = IN_WATER=true
      condition = NVGR_ROLLING_POWER < 80
  #elseifdef XMODE SIM
      condition  = DEPLOY = true
  #endif

  condition = MD = surfacing

  endflag = MD = fixing

   updates      = CONST_DEP_UPDATES  // example

   // Parameters specific to this behavior
   // ------------------------------------
            basewidth = 100          // default
                depth = 0            // default
   depth_mismatch_var = DEPTH_DIFF   // example
             duration = 6            // default
            peakwidth = 3            // default
          summitdelta = 50           // default
 }

 Behavior = BHV_ConstantSpeed
 {
   // General Behavior Parameters
   // ---------------------------
   name         = surfacing_spd  // example
   pwt          = 100                // default
   #ifdef XMODE SEASCOUT
      condition = IN_WATER=true
      condition = NVGR_ROLLING_POWER < 80
  #elseifdef XMODE SIM
      condition  = DEPLOY = true
  #endif
  condition = MD = surfacing

  endflag = MD = fixing

   updates      = CONST_SPD_UPDATES  // example

   // Parameters specific to this behavior
   // ------------------------------------
            basewidth = 0.2          // default
             duration = 6            // default
#ifdef XMODE SEASCOUT
      speed = 30
  #elseifdef XMODE SIM
      speed = 2.5
  #endif
   speed_mismatch_var = SPEED_DIFF   // example
            peakwidth = 0            // default
          summitdelta = 0            // default
 }

Behavior = BHV_ConstantHeading
 {
   // General Behavior Parameters
   // ---------------------------
   name         = surfacing_hdg            // example
   pwt          = 100                  // default
   #ifdef XMODE SEASCOUT
      condition = IN_WATER=true
      condition = NVGR_ROLLING_POWER < 80
  #elseifdef XMODE SIM
      condition  = DEPLOY = true
  #endif
  condition = MD = surfacing

  endflag = MD = fixing

   updates      = CONST_HDG_UPDATES    // example

   // Parameters specific to this behavior
   // ------------------------------------
              basewidth = 10           // default
               duration = 6            // default
                  heading = 210            // default
   heading_mismatch_var = HDG_DIFF     // example
              peakwidth = 10           // default
            summitdelta = 25           // default
 }
//**********************************************
// @(ACQUIRING FIX) DURATION=60, H=210, S=0, D=0
//----------------------------------------------
 
 Behavior = BHV_ConstantDepth
 {
   // General Behavior Parameters
   // ---------------------------
   name         = fixing_depth   // example
   pwt          = 100                // default
   #ifdef XMODE SEASCOUT
      condition = IN_WATER=true
      condition = NVGR_ROLLING_POWER < 80
  #elseifdef XMODE SIM
      condition  = DEPLOY = true
  #endif
  condition = MD = fixing

  endflag = MISSION_COMPLETE = true

   updates      = CONST_DEP_UPDATES  // example


   // Parameters specific to this behavior
   // ------------------------------------
            basewidth = 100          // default
                depth = 0            // default
   depth_mismatch_var = DEPTH_DIFF   // example
             duration = 60            // default
            peakwidth = 3            // default
          summitdelta = 50           // default
 }

 Behavior = BHV_ConstantSpeed
 {
   // General Behavior Parameters
   // ---------------------------
   name         = fixing_speed  // example
   pwt          = 100                // default
   #ifdef XMODE SEASCOUT
      condition = IN_WATER=true
      condition = NVGR_ROLLING_POWER < 80
  #elseifdef XMODE SIM
      condition  = DEPLOY = true
  #endif
  condition = MD = fixing

  endflag = MISSION_COMPLETE = true

   updates      = CONST_SPD_UPDATES  // example
   endflag = MISSION_COMPLETE=true


   // Parameters specific to this behavior
   // ------------------------------------
            basewidth = 0.2          // default
             duration = 60            // default
                speed = 0            // default
   speed_mismatch_var = SPEED_DIFF   // example
            peakwidth = 0            // default
          summitdelta = 0            // default
 }

Behavior = BHV_ConstantHeading
 {
   // General Behavior Parameters
   // ---------------------------
   name         = fixing_heading            // example
   pwt          = 100                  // default
   #ifdef XMODE SEASCOUT
      condition = IN_WATER=true
      condition = NVGR_ROLLING_POWER < 80
  #elseifdef XMODE SIM
      condition  = DEPLOY = true
  #endif
  condition = MD = fixing

  endflag = MISSION_COMPLETE = true

   updates      = CONST_HDG_UPDATES    // example
   endflag = MISSION_COMPLETE=true
   endflag = VIEW_RANGE_PULSE = x=0,y=0,radius=50,duration=10,fill=0.9,label=archie_ping, edge_color=white,fill_color=white,time=2700438154.35,edge_size=1


   // Parameters specific to this behavior
   // ------------------------------------
              basewidth = 10           // default
               duration = 60            // default
                  heading = 210            // default
   heading_mismatch_var = HDG_DIFF     // example
              peakwidth = 10           // default
            summitdelta = 25           // default
 }

 Behavior = BHV_MaxDepth
 {
   // General Behavior Parameters
   // ---------------------------
   name      = maxdepth
   pwt       = 1000
   condition = IN_WATER = true 
condition = NVGR_ROLLING_POWER < 80


   // Parameters specific to this behavior
   // ------------------------------------
         max_depth = 2 // (meters)
         tolerance = 0.5                // default (meters)
   depth_slack_var = DEPTH_SLACK      // example
 }