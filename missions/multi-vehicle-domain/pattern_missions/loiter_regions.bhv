//--------    Loiter regions   -------------

initialize   DEPLOY = false
initialize   LOITER_REGION = west
initialize    ACQUIRE_FIX = false

//----------------------------------------------
Behavior=BHV_ConstantDepth
{
  name       = const_depth
  pwt        = 100
  #ifdef XMODE SEASCOUT
      condition = IN_WATER=true
      condition = NVGR_ROLLING_POWER < 80
  #elseifdef XMODE SIM
      condition  = DEPLOY = true
  #endif
  condition    = ACQUIRE_FIX = false
  perpetual  = true

     duration = no-time-limit
        depth = 1

    basewidth = 20
    peakwidth = 3
  summitdelta = 50
}

//----------------------------------------------
Behavior=BHV_Loiter
{
  name       = loiter_west
  pwt        = 100

  #ifdef XMODE SEASCOUT
      condition = IN_WATER=true
      condition = NVGR_ROLLING_POWER < 80
  #elseifdef XMODE SIM
      condition  = DEPLOY = true
  #endif
  condition    = ACQUIRE_FIX = false

  condition  = LOITER_REGION = west
  duration   = 360
  perpetual  = true
  endflag    = LOITER_REGION = east

         polygon = format=radial, x=-160, y=-270, radius=30, pts=12, snap=1, label=LoiterPoly

  #ifdef XMODE SEASCOUT
      speed = 30
  #elseifdef XMODE SIM
      speed = 2.5
  #endif
           
  capture_radius = 5.0
     slip_radius = 15.0
       clockwise = false

    visual_hints = vertex_size=3, edge_size=1
    visual_hints = vertex_color=khaki, edge_color=gray50

}

//----------------------------------------------
Behavior=BHV_Loiter
{
  name       = loiter_east
  pwt        = 100

  #ifdef XMODE SEASCOUT
      condition = IN_WATER=true
      condition = NVGR_ROLLING_POWER < 80
  #elseifdef XMODE SIM
      condition  = DEPLOY = true
  #endif
  condition  = LOITER_REGION = east
  condition    = ACQUIRE_FIX = false

  duration   = 360
  perpetual  = true
  endflag    = ACQUIRE_FIX = true

         polygon = format=radial, x=-50, y=-170, radius=30, pts=12, snap=1, label=LoiterPoly

  #ifdef XMODE SEASCOUT
      speed = 30
  #elseifdef XMODE SIM
      speed = 2.5
  #endif

  capture_radius = 5.0
     slip_radius = 15.0
       clockwise = best

    visual_hints = vertex_size=3, edge_size=1
    visual_hints = vertex_color=khaki, edge_color=gray50
}

//**********************************************
// @(SURFACING) DURATION=6, H=210, S=30, D=0
//----------------------------------------------
 
 Behavior = BHV_ConstantDepth
 {
   // General Behavior Parameters
   // ---------------------------
   name         = surfacing_dpth   // example
   pwt          = 100                // default

   #ifdef XMODE SEASCOUT
      condition = IN_WATER=true
      condition = NVGR_ROLLING_POWER < 80
  #elseifdef XMODE SIM
      condition  = DEPLOY = true
  #endif
  condition    = ACQUIRE_FIX = true

   updates      = CONST_DEP_UPDATES  // example

   // Parameters specific to this behavior
   // ------------------------------------
            basewidth = 100          // default
                depth = 0            // default
   depth_mismatch_var = DEPTH_DIFF   // example
             duration = 6            // default
            peakwidth = 3            // default
          summitdelta = 50           // default
 }

 Behavior = BHV_ConstantSpeed
 {
   // General Behavior Parameters
   // ---------------------------
   name         = surfacing_spd  // example
   pwt          = 100                // default
   #ifdef XMODE SEASCOUT
      condition = IN_WATER=true
      condition = NVGR_ROLLING_POWER < 80
  #elseifdef XMODE SIM
      condition  = DEPLOY = true
  #endif
  condition    = ACQUIRE_FIX = true

   updates      = CONST_SPD_UPDATES  // example

   // Parameters specific to this behavior
   // ------------------------------------
            basewidth = 0.2          // default
             duration = 6            // default
                speed = 30            // default
   speed_mismatch_var = SPEED_DIFF   // example
            peakwidth = 0            // default
          summitdelta = 0            // default
 }

Behavior = BHV_ConstantHeading
 {
   // General Behavior Parameters
   // ---------------------------
   name         = surfacing_hdg            // example
   pwt          = 100                  // default
   #ifdef XMODE SEASCOUT
      condition = IN_WATER=true
      condition = NVGR_ROLLING_POWER < 80
  #elseifdef XMODE SIM
      condition  = DEPLOY = true
  #endif
  condition    = ACQUIRE_FIX = true

   updates      = CONST_HDG_UPDATES    // example

   // Parameters specific to this behavior
   // ------------------------------------
              basewidth = 10           // default
               duration = 6            // default
                  heading = 210            // default
   heading_mismatch_var = HDG_DIFF     // example
              peakwidth = 10           // default
            summitdelta = 25           // default
 }
//**********************************************
// @(ACQUIRING FIX) DURATION=60, H=210, S=0, D=0
//----------------------------------------------
 
 Behavior = BHV_ConstantDepth
 {
   // General Behavior Parameters
   // ---------------------------
   name         = fixing_depth   // example
   pwt          = 100                // default
   #ifdef XMODE SEASCOUT
      condition = NVGR_ROLLING_POWER < 80
  #elseifdef XMODE SIM
      condition  = DEPLOY = true
  #endif
  condition    = ACQUIRE_FIX = true

   updates      = CONST_DEP_UPDATES  // example


   // Parameters specific to this behavior
   // ------------------------------------
            basewidth = 100          // default
                depth = 0            // default
   depth_mismatch_var = DEPTH_DIFF   // example
             duration = 60            // default
            peakwidth = 3            // default
          summitdelta = 50           // default
 }

 Behavior = BHV_ConstantSpeed
 {
   // General Behavior Parameters
   // ---------------------------
   name         = fixing_speed  // example
   pwt          = 100                // default
   #ifdef XMODE SEASCOUT
      condition = NVGR_ROLLING_POWER < 80
  #elseifdef XMODE SIM
      condition  = DEPLOY = true
  #endif
  condition    = ACQUIRE_FIX = true

   updates      = CONST_SPD_UPDATES  // example
   endflag = MISSION_COMPLETE=true


   // Parameters specific to this behavior
   // ------------------------------------
            basewidth = 0.2          // default
             duration = 60            // default
                speed = 0            // default
   speed_mismatch_var = SPEED_DIFF   // example
            peakwidth = 0            // default
          summitdelta = 0            // default
 }

Behavior = BHV_ConstantHeading
 {
   // General Behavior Parameters
   // ---------------------------
   name         = fixing_heading            // example
   pwt          = 100                  // default
   #ifdef XMODE SEASCOUT

  #elseifdef XMODE SIM
      condition  = DEPLOY = true
  #endif
  condition    = ACQUIRE_FIX = true

   updates      = CONST_HDG_UPDATES    // example
   endflag = MISSION_COMPLETE=true
   endflag = VIEW_RANGE_PULSE = x=0,y=0,radius=50,duration=10,fill=0.9,label=archie_ping, edge_color=white,fill_color=white,time=2700438154.35,edge_size=1


   // Parameters specific to this behavior
   // ------------------------------------
              basewidth = 10           // default
               duration = 60            // default
                  heading = 210            // default
   heading_mismatch_var = HDG_DIFF     // example
              peakwidth = 10           // default
            summitdelta = 25           // default
 }

 Behavior = BHV_MaxDepth
 {
   // General Behavior Parameters
   // ---------------------------
   name      = maxdepth
   pwt       = 1000
   condition = IN_WATER = true 
condition = NVGR_ROLLING_POWER < 80
condition = IN_WATER = true


   // Parameters specific to this behavior
   // ------------------------------------
         max_depth = 2 // (meters)
         tolerance = 0.5                // default (meters)
   depth_slack_var = DEPTH_SLACK      // example
 }