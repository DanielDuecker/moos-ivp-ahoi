//--------------------------------------------------------
// iHBK_CV7 config Block 

ProcessConfig = iHBK_CV7
{
  apptick   = 10
  commstick = 10
  
  port = /dev/ttyACM0
  baudrate = 115200

  // Mounting rotations (degrees) - transform from sensor frame to vehicle frame
  mount_roll  = $(CV7_ROLL_OFFSET)
  mount_pitch = $(CV7_PITCH_OFFSET)
  mount_yaw   = $(CV7_YAW_OFFSET)

  roll_var = NAV_ROLL
  pitch_var = NAV_PITCH
  yaw_var = NAV_YAW
  heading_var = NAV_HEADING
  
  declination = -14.0833  // Manually setting north reference
  
  gravity = -9.81  // Gravity scale factor for acceleration
  
  debug = false
  verbose = false
  logging = true
  log_path = ./logs/$(MISSION_NAME)
}