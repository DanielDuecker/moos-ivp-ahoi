
initialize   DEPLOY  = false
initialize   RETURN  = false
initialize   LOITER  = false
initialize   AVOID   = true
initialize   GO_HOLD = false
initialize   RTRACK  = false
initialize   STATION_KEEP = false
initialize   INTERCEPT = false
  
set MODE = ACTIVE {
  DEPLOY = true
} INACTIVE

set MODE = RETURNING {
  MODE = ACTIVE
  RETURN = true
} 

set MODE = STATION-KEEPING {
  MODE = ACTIVE
  STATION_KEEP = true
}                       

set MODE = GOING_TO_HOLD {
  MODE = ACTIVE
  GO_HOLD = true
} 

set MODE = INTERCEPTING {
  MODE = ACTIVE
  INTERCEPT = true
} 

set MODE = RTRACKING {
  MODE = ACTIVE
  RTRACK = true
} 

set MODE = LOITERING {
  MODE = ACTIVE
  LOITER = true
} 


//----------------------------------------------
Behavior = BHV_TaskWaypoint
{ 
       name = twpt_
    updates = TASK_WPT
 templating = spawn
  condition = MODE==LOITERING
	
         type = waypoint
 max_bid_wins = false

   bidwonflag = RETURN = true
   bidwonflag = RETURN_UPDATE = point=$[PTX],$[PTY]
}

//----------------------------------------------
Behavior = BHV_TaskWaypoint
{ 
       name = taskhold_
    updates = TASK_HOLD
 templating = spawn
  condition = MODE==LOITERING

         type = gohold
 max_bid_wins = false

   bidwonflag = GO_HOLD = true
   bidwonflag = HOLD_UPDATE = point=$[PTX],$[PTY]
}


//----------------------------------------------
Behavior = BHV_StationKeep
{
  name         = station-keep
  pwt          = 100
  condition    = MODE==STATION-KEEPING
  inactiveflag = STATIONING = false
  activeflag   = STATIONING = true

     center_activate = true
        inner_radius = 5
        outer_radius = 10 
         outer_speed = 1.0

       transit_speed = 1.3
          swing_time = 7
        visual_hints = vertex_size=0, edge_color=gray50
}


//----------------------------------------------
Behavior = BHV_Loiter
{ 
  name      = loiter
  pwt       = 100
  condition = MODE==LOITERING
  updates   = LOITER_UPDATE
  perpetual = true

  endflag   = LOITER=false
  endflag   = RETURN=true
  //slingshot = 235
  //slingshot = 595

  //activeflag = ENCIRCLE_POSITION=x=20,y=-90,radius=45
  //activeflag = ENCIRCLE_POSITION=$(ENCIRC_POS),radius=45
  activeflag = ENCIRCLE_POSITION=$[CENTER],radius=$[RAD]
  configflag = ENCIRCLE_POSITION=$[CENTER],radius=$[RAD]

  // Parameters specific to this behavior
  // ------------------------------------
     acquire_dist = 3               
   capture_radius = 5 
	center_activate = false            
        clockwise = $(CLOCKWISE)
      slip_radius = 15
            speed = $(LOITER_SPD)         
        speed_alt = 1.2
    spiral_factor = 99  
         ipf_type = zaic_spd
	
         patience = 95
          polygon = radial::$(ENCIRC_POS),radius=$(ENCIRC_RAD),pts=16 

     visual_hints = vertex_size  = 1             // default
     visual_hints = edge_size    = 1             // default
     visual_hints = vertex_color = dodger_blue   // default
     visual_hints = edge_color   = white         // default
     visual_hints = nextpt_color = yellow        // default
     visual_hints = nextpt_lcolor = aqua         // default
     visual_hints = nextpt_vertex_size = 5       // default
     visual_hints = label = zone3                // example
}

//----------------------------------------------
Behavior=BHV_Waypoint
{
  name       = waypt_return
  pwt        = 100
  condition  = MODE==RETURNING
  perpetual  = true
  updates    = RETURN_UPDATE
  endflag    = RETURN = false
  endflag    = DEPLOY = false
  endflag    = MISSION = complete

	   speed = $(SPEED)
  capture_radius = 2.0
     slip_radius = 8.0

  #ifdef VNAME abe
    point = 52,9
  #elseifdef VNAME ben
    point = 39,4
  #elseifdef VNAME cal
    point = 29,0
  #elseifdef VNAME deb
    point = 16,-6
  #elseifdef VNAME eve
    point = 4,-11
  #elseifdef VNAME fin
    point = 2,-15
  #elseifdef VNAME max
    point = 26,-2
  #elseifdef VNAME ned
    point = 12,-8
  #else
    point = -2, -18
  #endif

 }

//---------------------------------------------- 
Behavior = BHV_AvdColregsV22
{
  name       = avdcol_
  pwt        = 500
  condition  = AVOID = true
  condition  = MODE==ACTIVE
  updates    = CONTACT_INFO
  endflag    = CONTACT_RESOLVED = $[CONTACT]
  templating = spawn

            contact = to-be-set
   on_no_contact_ok = true
        extrapolate = true
              decay = 30,60

        headon_only = true

  //velocity_filter = min_spd=0.2, max_spd=1.0, pct=40                 

       use_refinery = true

//    eval_tol = 30      

     pwt_outer_dist = 35
     pwt_inner_dist = 15
     completed_dist = 40
  min_util_cpa_dist = 10
  max_util_cpa_dist = 18
          pwt_grade = linear
   bearing_line_config = white:0, green:0.65, yellow:0.8, red:1.0  
}

//----------------------------------------------
//Behavior = BHV_AvoidCollision
{
  name       = avdcol_
  pwt        = 350
  condition  = AVOID = true 
  condition  = MODE==ACTIVE
  condition  = MODE!=ACTIVE:STATION-KEEPING
  updates    = CONTACT_INFO
  endflag    = CONTACT_RESOLVED = $[CONTACT]
  templating = spawn

             contact = to-be-set
    on_no_contact_ok = true
         extrapolate = true
               decay = 30,60

         use_refinery = true

        pwt_outer_dist = 35
        pwt_inner_dist = 10
        completed_dist = 40
     min_util_cpa_dist = 10
     max_util_cpa_dist = 18
             pwt_grade = linear
//   bearing_line_config = white:0, green:0.65, yellow:0.8, red:1.0
}


//----------------------------------------------
Behavior = BHV_Waypoint
{
  name      = wpt_rtrack
  pwt       = 100

  condition = MODE==RTRACKING
  updates   = RTRAC_UPDATE
  perpetual = true

//            lead = 8
//     lead_damper = 1
           speed = 1.4  // meters per second
	      
    capture_line = true
  capture_radius = 5
     slip_radius = 15
         polygon = oval: x=0, y=-210, rad=15, len=200, ang=90
           order = reverse
          repeat = 10000

	draw_path_loop = true
	
//       cycleflag = AAA_FOOBAR=true
//       cycleflag = WPT_CYCLES=$[CTR]
//       cycleflag = WPT_HASH=$[HASH]
	
    visual_hints = nextpt_color=yellow
    visual_hints = nextpt_vertex_size=8
    visual_hints = nextpt_lcolor=gray70
    visual_hints = vertex_color=light_green
    visual_hints = vertex_size=5
    visual_hints = edge_size=1
    visual_hints = edge_color=yellow
	
    visual_hints = trackpt_vertex_size=5
	  visual_hints = trackpt_vertex_color=gray50
	  visual_hints = trackpt_lcolor=off
}

//----------------------------------------------
Behavior = BHV_Trail
{
  name       = trail
  pwt        = 100
  condition  = MODE==INTERCEPTING
  updates    = TRAIL_INFO
//  templating = spawn

              contact = unset_ok
       pwt_outer_dist = 400
            nm_radius = 18
               radius = 8
          trail_angle = 180
          trail_range = 60

     trail_angle_type = relative
     on_no_contact_ok = true
          extrapolate = true
                decay = 30,60
  bearing_line_config = white:0, green:0.65, yellow:0.8, red:1.0
}
